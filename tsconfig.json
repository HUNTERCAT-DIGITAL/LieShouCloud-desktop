{
  "extends": "@lieshoucloud/config/tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client", "node", "vitest/globals", "@testing-library/jest-dom"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@lieshoucloud/api-client": ["open/api-client/src"],
