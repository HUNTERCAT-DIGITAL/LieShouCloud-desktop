{
  "extends": "@lieshoucloud/contract-config/tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "vite/client",
      "node",
      "vitest/globals",
      "@testing-library/jest-dom"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@lieshoucloud/contract-api": [
        "open/contract-api/src"
      ],
      "@lieshoucloud/contract-types": [
        "open/contract-types/src"
      ],
      "@lieshoucloud/ui": [
        "open/ui/src"
      ],
      "@lieshoucloud/boot": [
        "../packages/boot/src/index.ts"
      ],
      "@lieshoucloud/boot/*": [
        "../packages/boot/src/*"
      ],
      "@lieshoucloud/core-web": [
        "open/core-web/src"
      ],
      "@lieshoucloud/legalmind": [
        "../packages/legalmind/src"
      ],
      "@lieshoucloud/legalmind/*": [
        "../packages/legalmind/src/*"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "src/config/editions/*.extra.ts"
  ]
}
