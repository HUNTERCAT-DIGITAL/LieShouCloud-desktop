{
  "name": "@lieshoucloud/desktop-app",
  "version": "0.1.8",
  "private": true,
  "type": "module",
  "description": "猎手云桌面端（Tauri 2 + React 19 + Vite）· 端自身最小骨架（零上游共享依赖）。",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@ant-design/icons": "~5.5.1",
    "@ant-design/pro-components": "^2.8.0",
    "@lieshoucloud/contract-api": "workspace:*",
    "@lieshoucloud/contract-config": "workspace:*",
    "@lieshoucloud/contract-types": "workspace:*",
    "@lieshoucloud/core-web": "workspace:*",
    "@lieshoucloud/i18n": "workspace:*",
    "@tauri-apps/api": "~2.0.0",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-shell": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "antd": "^5.22.0",
    "dayjs": "~1.11.13",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@playwright/test": "^1.49.0",
    "@tauri-apps/cli": "~2.0.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "~22.9.0",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.3.3",
    "eslint": "9.15.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-react-hooks": "^6.1.1",
    "jsdom": "30.0.1",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "typescript-eslint": "8.15.0",
    "vite": "6.4.3",
    "vitest": "3.0.5"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "pnpm": ">=9.0.0 <10.0.0"
  },
  "packageManager": "pnpm@9.12.0"
}
