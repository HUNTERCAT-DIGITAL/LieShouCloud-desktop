{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "LieShou Cloud Desktop",
  "version": "0.0.11",
  "identifier": "cn.huntercat.lieshoucloudpro.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LieShou Cloud Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "LieShou Cloud Desktop",
    "longDescription": "LieShou Cloud Desktop - Tauri 2 + React 19 desktop application"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzRUNBN0JEOEJCMTk5MzYKUldRMm1iR0x2YWZzd3pNai9wN0J6SHBkVnVCNTBYRkZFN0lTQnVNc3NyaGQ2bWcvd29HQVUzT0EK",
      "endpoints": ["https://updates.lieshoucloud.huntercat.cn/updates/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
